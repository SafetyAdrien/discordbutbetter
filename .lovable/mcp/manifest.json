{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ixdznbvbjjnydqttmaam.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "nexuschat-mcp",
      "version": "0.1.0",
      "title": "NexusChat MCP"
    },
    "tools": [
      {
        "name": "list_my_servers",
        "title": "List my servers",
        "description": "List the NexusChat servers (guilds) the signed-in user is a member of.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_channels",
        "title": "List channels of a server",
        "description": "List the channels of a NexusChat server the signed-in user belongs to.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "server_id": {
              "type": "string",
              "format": "uuid",
              "description": "Target server (guild) id."
            }
          },
          "required": [
            "server_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_message",
        "title": "Send a message to a channel",
        "description": "Send a text message as the signed-in user to a NexusChat text channel they can post in.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "channel_id": {
              "type": "string",
              "format": "uuid",
              "description": "Target channel id."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "Plain-text message content (markdown supported)."
            }
          },
          "required": [
            "channel_id",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
