# Origines autorisées à appeler les edge functions depuis un navigateur.
# Liste séparée par des virgules. NE PAS utiliser "*" : les fonctions
# acceptent un en-tête Authorization, donc un CORS ouvert supprime la
# frontière d'origine.
ALLOWED_ORIGINS=https://nexuschat.app,http://localhost:8080

# Secrets (déjà existants) — ne jamais commiter.
# OPENAI_API_KEY=
# GIPHY_API_KEY=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
